<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<Version>1.0.1</Version>
		<AssemblyVersion>1.0.1.0</AssemblyVersion>
		<FileVersion>1.0.1.0</FileVersion>
		<InformationalVersion>1.0.1-beta</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
		<PackageReference Include="DNS" Version="7.0.0" />
		<PackageReference Include="Flexinets.Ldap.Core" Version="1.0.86" />
		<PackageReference Include="log4net" Version="3.2.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

		<PackageReference Include="System.ServiceModel.Primitives" Version="8.1.*" />
		<PackageReference Include="System.ServiceModel.Http" Version="8.1.*" />
		<PackageReference Include="System.ServiceModel.NetTcp" Version="8.1.*" />

		<PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.*" />

		<PackageReference Include="System.Xml.XmlSerializer" Version="4.3.0" />
	</ItemGroup>

</Project>
