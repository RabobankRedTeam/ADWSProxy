<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- CS8981: the svcutil-generated ActiveDirectoryWebService.cs declares lower-case types (e.g. "schema"). -->
		<NoWarn>$(NoWarn);CS8981</NoWarn>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<Version>2026.11.0</Version>
		<AssemblyVersion>2026.11.0.0</AssemblyVersion>
		<FileVersion>2026.11.0.0</FileVersion>
		<InformationalVersion>2026.11.0</InformationalVersion>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsPreviewNamespaces>
		<PublishSingleFile>true</PublishSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ARSoft.Tools.Net" Version="3.6.1" />
		<PackageReference Include="Flexinets.Ldap.Core" Version="1.0.86" />
		<PackageReference Include="log4net" Version="3.3.2" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />

		<PackageReference Include="System.ServiceModel.Primitives" Version="10.1.0" />
		<PackageReference Include="System.ServiceModel.Http" Version="10.1.0" />
		<PackageReference Include="System.ServiceModel.NetTcp" Version="10.1.0" />

		<PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.15" />

		<RuntimeHostConfigurationOption Include="System.Net.Security.UseManagedNtlm" Value="true" />
	</ItemGroup>

</Project>
