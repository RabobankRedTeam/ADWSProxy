<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<InformationalVersion>2.0.0-beta</InformationalVersion>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsPreviewNamespaces>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ARSoft.Tools.Net" Version="3.6.1" />
		<PackageReference Include="Flexinets.Ldap.Core" Version="1.0.86" />
		<PackageReference Include="log4net" Version="3.2.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />

		<PackageReference Include="System.ServiceModel.Primitives" Version="8.1.*" />
		<PackageReference Include="System.ServiceModel.Http" Version="8.1.*" />
		<PackageReference Include="System.ServiceModel.NetTcp" Version="8.1.*" />

		<PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.*" />

		<PackageReference Include="System.Xml.XmlSerializer" Version="4.3.0" />

		<RuntimeHostConfigurationOption Include="System.Net.Security.UseManagedNtlm" Value="true" />
	</ItemGroup>

</Project>
