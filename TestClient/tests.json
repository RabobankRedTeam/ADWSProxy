{
  "Server": "{{LOGONSERVER}}",
  "Queries": [
    {
      "Name": "T1 - Domain context",
      "Description": "Standard domain partition sweep targeting the base domain DN for standard AD objects.",
      "TargetOUs": [ "{{DOMAIN_DN}}" ],
      "Filter": "(objectGuid=*)",
      "Scope": "Subtree",
      "Attributes": [
        "distinguishedname",
        "*"
      ],
      "Engines": [
        "ADWS",
        "LDAP",
        "LDAPS"
      ]
    },
    {
      "Name": "T2 - Configuration context",
      "Description": "Targets the Configuration partition.",
      "TargetOUs": [ "CN=Configuration,{{DOMAIN_DN}}" ],
      "Filter": "(objectClass=*)",
      "Scope": "Subtree",
      "Attributes": [
        "distinguishedname",
        "*"
      ],
      "Engines": [
        "ADWS",
        "LDAP",
        "LDAPS"
      ]
    },
    {
      "Name": "T3 - Full RootDSE Domain Expansion Sweep",
      "Description": "Expands to all naming contexts matching the domain DN.",
      "TargetOUs": [ "{{allContexts:{{DOMAIN_DN}}}}" ],
      "Filter": "(objectClass=*)",
      "Scope": "Subtree",
      "Attributes": [
        "distinguishedname",
        "*"
      ],
      "Engines": [
        "ADWS",
        "LDAP",
        "LDAPS"
      ]
    },
    {
      "Name": "T4 - Full GC Sweep",
      "Description": "Uses Global Catalog to perform forest-wide object discovery via the Partial Attribute Set",
      "TargetOUs": [ "{{allContexts}}" ],
      "Filter": "(objectClass=*)",
      "Scope": "Subtree",
      "Attributes": [
        "distinguishedname",
        "*"
      ],
      "Engines": [
        "ADWS-GC",
        "LDAP-GC",
        "LDAPS-GC"
      ]
    },
    {
      "Name": "T5 - Full RootDSE Expansion Sweep",
      "Description": "Queries RootDSE for all namingContexts across the forest and executes test passes against every partition.",
      "TargetOUs": [ "{{allContexts}}" ],
      "Filter": "(objectClass=*)",
      "Scope": "Subtree",
      "Attributes": [
        "distinguishedname",
        "*"
      ],
      "Engines": [
        "ADWS",
        "LDAP",
        "LDAPS"
      ]
    }
  ]
}